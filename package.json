{
  "name": "launch-control",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run build:docs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src && npm run test:docs",
    "test:e2e": "playwright test",
    "build:docs": "node scripts/build-docs.mjs",
    "test:docs": "node --test scripts/build-docs.test.mjs"
  },
  "dependencies": {
    "lucide-react": "1.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "github-slugger": "2.0.0",
    "markdown-it": "15.0.2",
    "typescript": "6.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
